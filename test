    <script>
    (function(){
        function updateChannel(data) {
            var iframe = document.getElementById('playerFrame');
            if (iframe) iframe.src = data.embed;
            document.title = data.name + ' — смотреть онлайн бесплатно, прямой эфир';
            var infoImg = document.querySelector('.channel-info img');
            if (infoImg) { infoImg.src = data.logo; infoImg.alt = 'Канал ' + data.name + ' - смотреть онлайн бесплатно'; }
            var infoH1 = document.querySelector('.channel-info-text h1');
            if (infoH1) infoH1.textContent = data.name;
            var infoP = document.querySelector('.channel-info-text p');
            if (infoP) infoP.textContent = data.category_name;
            var hlsBtn = document.getElementById('shareCopyHls');
            if (hlsBtn) hlsBtn.dataset.hlsUrl = data.hls_url || '';
            history.pushState({channelId: data.id}, '', '/tv/watch/' + data.id);
            if (window.ym) ym(104014182, 'hit', '/tv/watch/' + data.id);
        }

        function setActiveChannel(channelId) {
            var sidebar = document.getElementById('watchSidebar');
            if (!sidebar) return;
            sidebar.querySelectorAll('.sidebar-channel').forEach(function(link) {
                link.classList.remove('active');
                if (link.dataset.channelId === channelId) link.classList.add('active');
            });
        }

        document.addEventListener('click', function(e) {
            var link = e.target.closest('.sidebar-channel');
            if (!link) return;
            if (e.ctrlKey || e.metaKey || e.button !== 0) return;
            e.preventDefault();
            var channelId = link.dataset.channelId;
            if (!channelId) return;
            fetch('/tv/api/channel/' + channelId)
                .then(function(r) { if (!r.ok) throw new Error('Network'); return r.json(); })
                .then(function(data) {
                    updateChannel(data);
                    setActiveChannel(channelId);
                })
                .catch(function() { window.location.href = link.href; });
        });

        window.addEventListener('popstate', function(e) {
            if (e.state && e.state.channelId) {
                fetch('/tv/api/channel/' + e.state.channelId)
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        updateChannel(data);
                        setActiveChannel(data.id);
                    });
            }
        });

        document.addEventListener('click', function(e) {
            var toggle = e.target.closest('#shareToggle');
            var menu = document.getElementById('shareMenu');
            if (toggle && menu) { e.stopPropagation(); menu.classList.toggle('show'); return; }
            if (menu && !menu.contains(e.target) && !e.target.closest('#shareToggle')) menu.classList.remove('show');
        });

        document.addEventListener('click', function(e) {
            var copyBtn = e.target.closest('#shareCopy');
            if (!copyBtn) return;
            e.preventDefault();
            var url = window.location.href;
            var copyText = document.getElementById('shareCopyText');
            if (!copyText) return;
            var originalText = copyText.textContent;
            navigator.clipboard.writeText(url).catch(function(err) {
                var ta = document.createElement('textarea'); ta.value = url;
                document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
            }).finally(function() {
                copyText.textContent = 'Скопировано!';
                var icon = copyBtn.querySelector('.share-icon');
                if (icon) icon.style.stroke = '#22c55e';
                setTimeout(function() {
                    copyText.textContent = originalText;
                    if (icon) icon.style.stroke = '';
                    var menu = document.getElementById('shareMenu');
                    if (menu) menu.classList.remove('show');
                }, 1500);
            });
        });

        document.addEventListener('click', function(e) {
            var copyBtn = e.target.closest('#shareCopyHls');
            if (!copyBtn) return;
            e.preventDefault();
            var hls_url = copyBtn.dataset.hlsUrl || '';
            var copyText = document.getElementById('shareCopyTextHls');
            if (!copyText) return;
            var originalText = copyText.textContent;
            navigator.clipboard.writeText(hls_url).catch(function(err) {
                var ta = document.createElement('textarea'); ta.value = hls_url;
                document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
            }).finally(function() {
                copyText.textContent = 'Скопировано!';
                setTimeout(function() {
                    copyText.textContent = originalText;
                    var menu = document.getElementById('shareMenu');
                    if (menu) menu.classList.remove('show');
                }, 1500);
            });
        });

        document.addEventListener('click', function(e) {
            var tgBtn = e.target.closest('#shareTelegram');
            if (!tgBtn) return;
            var url = window.location.href;
            var nameEl = document.querySelector('.channel-info-text h1');
            var text = '👀 Смотрю ' + (nameEl ? nameEl.textContent : 'канал') + ' онлайн бесплатно на Kinowalk 🍿🎬';
            tgBtn.href = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(text);
        });
    })();
    </script>
